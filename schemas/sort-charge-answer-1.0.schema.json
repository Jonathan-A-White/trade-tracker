{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sort-charge-answer-1.0",
  "title": "Sort Charge answer 1.0",
  "description": "One category, or a split across categories, and a one-line why.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "why"
  ],
  "anyOf": [
    {
      "required": [
        "category"
      ]
    },
    {
      "required": [
        "split"
      ]
    }
  ],
  "properties": {
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "split": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "amount"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}
