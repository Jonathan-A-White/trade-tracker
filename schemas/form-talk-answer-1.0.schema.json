{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "form-talk-answer-1.0",
  "title": "Form Talk answer 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "form_values": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 40
          },
          "value": {
            "type": "string",
            "maxLength": 1200
          }
        }
      }
    },
    "form_ask": {
      "type": "string",
      "maxLength": 40
    }
  }
}
