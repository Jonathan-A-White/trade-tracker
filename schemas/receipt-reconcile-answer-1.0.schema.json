{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "receipt-reconcile-answer-1.0",
  "title": "Receipt Reconcile answer 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "store",
    "date",
    "subtotal",
    "tax",
    "total",
    "lines",
    "unreadable"
  ],
  "properties": {
    "store": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "subtotal": {
      "type": [
        "number",
        "null"
      ]
    },
    "tax": {
      "type": [
        "number",
        "null"
      ]
    },
    "total": {
      "type": [
        "number",
        "null"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "price",
          "quantity",
          "weightLbs",
          "tripItemId",
          "confidence"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "weightLbs": {
            "type": [
              "number",
              "null"
            ]
          },
          "tripItemId": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "unreadable": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
