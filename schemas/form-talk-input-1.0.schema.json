{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "form-talk-input-1.0",
  "title": "Form Talk input 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "history",
    "form"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "history": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 1200
          },
          "a": {
            "type": "string",
            "maxLength": 1200
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "command": {
          "type": "string",
          "maxLength": 40
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "label",
              "required",
              "kind",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "hint": {
                "type": "string",
                "maxLength": 120
              },
              "required": {
                "type": "boolean"
              },
              "kind": {
                "enum": [
                  "text",
                  "link",
                  "choice",
                  "pictures"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 600
              },
              "options": {
                "type": "array",
                "maxItems": 60,
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          }
        }
      }
    }
  }
}
