{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "item-from-photos-input-1.0",
  "title": "Item From Photos input 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "barcode",
    "mode"
  ],
  "properties": {
    "barcode": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "new-item",
        "price-only"
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
