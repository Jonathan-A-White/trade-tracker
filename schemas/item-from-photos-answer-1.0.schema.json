{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "item-from-photos-answer-1.0",
  "title": "Item From Photos answer 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "category",
    "unitType",
    "price",
    "confidence"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "Bakery",
        "Beverages",
        "Breakfast & Cereal",
        "Canned Goods",
        "Condiments & Sauces",
        "Dairy & Eggs",
        "Deli",
        "Frozen Foods",
        "Grains, Pasta & Sides",
        "Health & Beauty",
        "Household & Cleaning",
        "International Foods",
        "Meat & Seafood",
        "Oils & Vinegars",
        "Paper & Plastic Goods",
        "Pet Supplies",
        "Produce",
        "Snacks & Candy",
        "Spices & Seasonings",
        "other"
      ]
    },
    "unitType": {
      "enum": [
        "each",
        "per_lb"
      ]
    },
    "price": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "size": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
